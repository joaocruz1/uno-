# Local defaults only; replace before deployment. Never commit .env.local.
DATABASE_URL=postgresql://uno:uno@localhost:55432/uno
REDIS_URL=redis://localhost:56379
UNO_ALLOW_DRAFT_TEMPLATES=true
UNO_BATCH_UPLOAD_SESSION_TTL_SECONDS=86400
UNO_BATCH_ARCHIVE_MAX_BYTES=107374182400
UNO_BATCH_ARCHIVE_TIMEOUT_MS=1800000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=uno
S3_ACCESS_KEY_ID=uno-local
S3_SECRET_ACCESS_KEY=uno-local-secret
RESEND_API_KEY=
EMAIL_FROM=UNO <no-reply@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
UNO_STRIPE_WEBHOOK_MAX_BYTES=1048576
UNO_BILLING_RECONCILE_STALE_SECONDS=21600
UNO_PLAN_FREE_PRICE_BRL_CENTS=0
UNO_PLAN_FREE_MONTHLY_LIMIT=10
UNO_PLAN_FREE_MAX_FILE_MB=5
UNO_PLAN_FREE_BATCH_LIMIT=1
UNO_PLAN_FREE_RETENTION_DAYS=7
UNO_PLAN_FREE_RATE_LIMIT=30
UNO_PLAN_STARTER_PRICE_BRL_CENTS=1900
UNO_PLAN_STARTER_MONTHLY_LIMIT=300
UNO_PLAN_STARTER_MAX_FILE_MB=20
UNO_PLAN_STARTER_BATCH_LIMIT=50
UNO_PLAN_STARTER_RETENTION_DAYS=30
UNO_PLAN_STARTER_RATE_LIMIT=30
UNO_PLAN_PRO_PRICE_BRL_CENTS=4900
UNO_PLAN_PRO_MONTHLY_LIMIT=2000
UNO_PLAN_PRO_MAX_FILE_MB=50
UNO_PLAN_PRO_BATCH_LIMIT=100
UNO_PLAN_PRO_RETENTION_DAYS=90
UNO_PLAN_PRO_RATE_LIMIT=60
UNO_PLAN_BUSINESS_PRICE_BRL_CENTS=13900
UNO_PLAN_BUSINESS_MONTHLY_LIMIT=10000
UNO_PLAN_BUSINESS_MAX_FILE_MB=100
UNO_PLAN_BUSINESS_BATCH_LIMIT=500
UNO_PLAN_BUSINESS_RETENTION_DAYS=180
UNO_PLAN_BUSINESS_RATE_LIMIT=120
# 32 bytes: 64 hex chars or base64/base64url. Rotate by bumping the version and
# keeping the previous key as WEBHOOK_ENCRYPTION_KEY_<VERSION>.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY_VERSION=v1
UNO_WEBHOOK_TIMEOUT_MS=10000
UNO_WEBHOOK_MAX_ACTIVE_ENDPOINTS=10
UNO_API_UPLOAD_DEADLINE_MS=1800000
DATABASE_POOL_MAX=10
UNO_INVITATION_TTL_HOURS=168
UNO_MAX_OWNED_ORGANIZATIONS=10
UNO_MAX_PENDING_INVITATIONS=50
UNO_MANAGEMENT_RATE_LIMIT=30
UNO_INVITATION_RATE_LIMIT=20
UNO_INVITATION_ACCEPT_RATE_LIMIT=10
UNO_ADMIN_RATE_LIMIT=120
UNO_RELEASE_MAX_TOLERANCE_MM=2
UNO_RETENTION_INTERVAL_MS=60000
UNO_RETENTION_BATCH_SIZE=50
UNO_RETENTION_LEASE_MS=300000
UNO_RETENTION_UPLOAD_GRACE_MS=900000
UNO_ENGINE_TMP_MAX_AGE_MS=3600000
# Anonymous landing trial (one conversion per visitor).
UNO_TRIAL_ATTEMPTS_PER_HOUR=6
UNO_TRIAL_GLOBAL_PER_MINUTE=30
UNO_TRIAL_CONCURRENCY=2
# Extra HTTPS origins allowed by the Content-Security-Policy connect-src.
UNO_CSP_CONNECT_SRC=
ADMIN_EMAILS=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional local Mailpit; production uses Resend.
SMTP_URL=smtp://127.0.0.1:1025
TESSDATA_PREFIX=
SUPPORT_EMAIL=
