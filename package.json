{
  "name": "uno",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/prepare-pdf-worker.mjs && next dev",
    "build": "node scripts/prepare-pdf-worker.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/workers/index.ts",
    "test:e2e": "playwright test",
    "check": "node scripts/verify-phase.mjs",
    "dev:s3": "node --env-file-if-exists=.env.local scripts/local-s3.mjs",
    "stripe:setup": "node --import tsx scripts/stripe-setup.ts",
    "admin:local": "node --env-file-if-exists=.env.local --import tsx scripts/create-local-admin.ts",
    "proof:print": "node --env-file-if-exists=.env.local --import tsx scripts/generate-print-proof.ts",
    "bench:engine": "node --import tsx scripts/bench-engine.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@sentry/nextjs": "^11.4.0",
    "@zxing/library": "^0.23.0",
    "archiver": "^8.0.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "posthog-js": "^1.437.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/bwip-js": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bwip-js": "^4.11.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "qrcode": "^1.5.4",
    "s3rver": "^3.7.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
